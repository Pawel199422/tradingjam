{
  "expo": {
    "name": "TradingJam",
    "slug": "tradingjam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f17",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f17"
    },
    "android": {
      "package": "pl.tradingjam.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f17"
      }
    },
    "ios": {
      "bundleIdentifier": "pl.tradingjam.app",
      "supportsTablet": false
    },
    "web": {
      "name": "TradingJam",
      "shortName": "TradingJam",
      "favicon": "./assets/favicon.png",
      "themeColor": "#0b0f17",
      "backgroundColor": "#0b0f17",
      "bundler": "metro",
      "output": "single"
    }
  }
}
